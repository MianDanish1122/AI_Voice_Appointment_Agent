# ===== LLM (free options) =====
# Option 1 (recommended): Groq free API -> https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_key_here
LLM_MODEL=openai/gpt-oss-120b

# Option 2: Google Gemini free API -> https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your_gemini_key_here
# LLM_MODEL=gemini-2.5-flash

# Option 3: Ollama (100% local, no key) -> https://ollama.com  then: ollama pull qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# ===== Business =====
BUSINESS_NAME=Acme Digital Solutions
AGENT_NAME=Sara
TIMEZONE=Asia/Karachi
# Working days: 0=Mon ... 6=Sun
WORK_DAYS=0,1,2,3,4
OPEN_TIME=10:00
CLOSE_TIME=18:00
SLOT_MINUTES=30

# ===== Human transfer =====
# Number in E.164 format. On a Twilio trial this number must be "verified" in Twilio console.
HUMAN_PHONE=+923001234567

# ===== Twilio voice settings =====
# Speech recognition language: en-US, en-IN, hi-IN, ur-PK ...
STT_LANGUAGE=en-US
# Text-to-speech voice + language. For Hindi/Urdu style speech try: Polly.Aditi + hi-IN
TTS_VOICE=Polly.Joanna-Neural
TTS_LANGUAGE=en-US

# ===== Google Calendar =====
# Calendar ID (Google Calendar -> Settings -> your calendar -> 'Integrate calendar' -> Calendar ID; usually your gmail)
GOOGLE_CALENDAR_ID=
# Service account key file placed in the project folder
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json


# ===== Optional: extra free AI provider (used when Groq hits its free limit) =====
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Natural voice for the web call (free). Other options: en-US-AriaNeural, en-US-JennyNeural, en-US-AndrewNeural
WEB_TTS_VOICE=en-US-AvaMultilingualNeural

